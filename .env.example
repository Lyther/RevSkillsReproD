# Copied to .env by `make setup`. No secrets.
COMPOSE_PROJECT_NAME=revskillsrepro
# Informational pin; the image is built from the recorded submodule commit.
REV_SKILLS_TAG=v0.0.5+marketplace

# Optional ByteLLM probe (scripts/probe-llm.sh, scripts/live-skill.sh).
# Client key lives in ~/.ssh/bytellm (line 11). ByteLLM/.env line 11 is the
# upstream Qwen3-max registry key — do not send it as Bearer.
# BYTELLM_BASE_URL=http://127.0.0.1:4000/v1
# BYTELLM_KEY_FILE=
# BYTELLM_KEY_LINE=11
# BYTELLM_MODEL=qwen3-max
